# Copy to .env and fill in. Never commit the real file.

# Required. Get one from https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# Where the book of business comes from.
#   sample - bundled synthetic book (default; safe for demos, no client data)
#   json   - a single JSON file matching src/data/schema.js
#   csv    - a directory holding clients.csv, policies.csv, members.csv, claims.csv
BOOK_SOURCE=sample
BOOK_PATH=./data/book.json

# Model + reasoning effort for the analyst.
AIB_MODEL=claude-opus-5
AIB_EFFORT=high

# TTD per USD, used to normalise USD-denominated lines (e.g. the international health plan).
AIB_FX_TTD_PER_USD=6.8

# How AIB stands in relation to the health third-party administrator. This is not
# inferable from the book and it changes what the system recommends, what it says
# AIB earns, and how it is allowed to describe the arrangement. Set it before
# trusting anything the system says about the administration lines.
#   none        no relationship — administration lines are removed entirely
#   partner     arm's-length referral or placement, AIB earns a share (default)
#   subsidiary  the TPA is part of the AIB group, the whole fee is AIB's
AIB_TPA_RELATIONSHIP=partner
AIB_TPA_NAME=Cardea

# The holding company AIB and the administrator both sit under, if there is one.
# Separate from the commercial relationship above: sister companies still invoice
# each other, but keeping work inside the group is an argument worth making, and
# the analyst will not make it unless told the group exists.
AIB_GROUP_NAME=AIBHL

# AIB's share of an administration fee, 0..1. The fallback is a placeholder —
# replace it with the real number before anyone acts on the pipeline totals.
AIB_TPA_REVENUE_SHARE=0.15

# Port for the broker console.
PORT=4000
